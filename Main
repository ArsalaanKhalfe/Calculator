import math

history = []

def calculator(numbers, operator):

    if operator == '+':
        return sum(numbers)

    elif operator == '-':
        result = numbers[0]
        for n in numbers[1:]:
            result = result - n
        return result

    elif operator == '*':
        result = 1
        for n in numbers:
            result = result * n
        return result

    elif operator == '/':
        result = numbers[0]
        for n in numbers[1:]:
            if n == 0:
                return "Cannot divide by zero."
            result = result / n
        return result

    elif operator == '//':
        if numbers[1] == 0:
            return "Cannot divide by zero."
        return numbers[0] // numbers[1]

    elif operator == '%':
        if numbers[1] == 0:
            return "Cannot divide by zero."
        return numbers[0] % numbers[1]

    elif operator == '**':
        return numbers[0] ** numbers[1]

    elif operator == 'percent':
        return (numbers[0] / numbers[1]) * 100

    elif operator == 'sqrt':
        if numbers[0] < 0:
            return "Cannot calculate square root."
        return math.sqrt(numbers[0])

    elif operator == 'abs':
        return abs(numbers[0])

    elif operator == 'factorial':
        if numbers[0] < 0 or numbers[0] != int(numbers[0]):
            return "Enter a non-negative integer."
        return math.factorial(int(numbers[0]))

    elif operator == 'sin':
        return math.sin(math.radians(numbers[0]))

    elif operator == 'cos':
        return math.cos(math.radians(numbers[0]))

    elif operator == 'tan':
        return math.tan(math.radians(numbers[0]))

    elif operator == 'log':
        if numbers[0] <= 0:
            return "Invalid number for logarithm."
        return math.log(numbers[0])

    elif operator == 'log10':
        if numbers[0] <= 0:
            return "Invalid number for logarithm."
        return math.log10(numbers[0])

    else:
        return "Wrong operator."


print("===== ADVANCED CALCULATOR =====")
print("Operators: +, -, *, /, //, %, **, percent")
print("Scientific: sqrt, abs, factorial, sin, cos, tan, log, log10")
print("Commands: history, clear_history, quit")

while True:

    operator = input("\nEnter operator: ").lower()

    if operator == 'quit':
        print("Goodbye!")
        break

    elif operator == 'history':
        for item in history:
            print(item)
        if len(history) == 0:
            print("No history available.")
        continue

    elif operator == 'clear_history':
        history.clear()
        print("History cleared.")
        continue

    try:
        if operator in ['+', '-', '*', '/']:
            numbers = input("Enter numbers separated by spaces: ")
            numbers = [float(n) for n in numbers.split()]

        elif operator in ['//', '%', '**', 'percent']:
            n1 = float(input("Enter first number: "))
            n2 = float(input("Enter second number: "))
            numbers = [n1, n2]

        else:
            n1 = float(input("Enter number: "))
            numbers = [n1]

        result = calculator(numbers, operator)
        print("Result:", result)

        if not isinstance(result, str):
            history.append(str(numbers) + " " + operator + " = " + str(result))

    except ValueError:
        print("Please enter valid numbers.")
